{
  "name": "kairos",
  "displayName": "Kairos — Code Impact",
  "description": "Understand an unfamiliar Java codebase and see the potential ripple effects of changing a file.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kairos.analyzeCodebase",
        "title": "Code Impact: Analyze Codebase"
      },
      {
        "command": "kairos.showImpact",
        "title": "Code Impact: Show Impact"
      }
    ],
    "configuration": {
      "title": "Kairos",
      "properties": {
        "kairos.includeHistory": {
          "type": "boolean",
          "default": false,
          "description": "Include git co-change history (files that frequently changed alongside the selected file) as 'historical' entries in the impact view. Off by default: it costs an extra git-log walk per analysis."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:ci": "bash scripts/run-tests-headless.sh",
    "test:junit": "KAIROS_JUNIT_OUT=./reports/extension-junit.xml npm run test:ci"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "glob": "^13.0.6",
    "mocha": "^10.4.0",
    "mocha-junit-reporter": "^2.2.1",
    "typescript": "^5.4.0"
  }
}
